# Email Notification Configuration (Gmail & SMTP)
# 1. EMAIL_USER: Your Gmail address (e.g. harshtechsolutions.in@gmail.com)
# 2. EMAIL_PASS: 16-character Google App Password (not your standard Gmail login password)
#    Generate it here: https://myaccount.google.com/apppasswords
# 3. ADMIN_EMAIL: Recipient email address to receive lead notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
ADMIN_EMAIL=abhibadadhe@harshtechsolutions.in
EMAIL_FROM="Harsh Tech Solutions" <your-email@gmail.com>

